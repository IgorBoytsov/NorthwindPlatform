<prism:PrismApplication x:Class="NorthwindPlatform.Wpf.Shell.App"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:prism="http://prismlibrary.com/"
                        xmlns:converters="clr-namespace:Shared.UI.Wpf.ValueConverters;assembly=Shared.UI.Wpf"
                        ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Shared.UI.Wpf;component/Resources/Brushes/Brushes.Shared.xaml"/>

                <ResourceDictionary Source="/Shared.UI.Wpf;component/Resources/Styles/Button.xaml"/>
                <ResourceDictionary Source="/Shared.UI.Wpf;component/Resources/Styles/ComboBox.xaml"/>
                <ResourceDictionary Source="/Shared.UI.Wpf;component/Resources/Styles/TextBlock.xaml"/>
                <ResourceDictionary Source="/Shared.UI.Wpf;component/Resources/Styles/TextBox.xaml"/>

                <ResourceDictionary Source="/Shared.UI.Wpf;component/Resources/Dimensions/Dimensions.xaml"/>
                <ResourceDictionary Source="/Shared.UI.Wpf;component/Resources/Fonts/Typography.xaml"/>
                <ResourceDictionary Source="/Shared.UI.Wpf;component/Resources/Geometries/Icons.xaml"/>

                <ResourceDictionary Source="/Shared.UI.Wpf;component/Resources/Theme.Dark.xaml"/>
                <!--<ResourceDictionary Source="/Shared.UI.Wpf;component/Resources/Theme.Light.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>