<UserControl x:Class="NorthwindPlatform.Modules.Authentication.Wpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NorthwindPlatform.Modules.Authentication.Wpf.Views"
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:viewmodels="clr-namespace:NorthwindPlatform.Modules.Authentication.Wpf.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" >

    <Border Background="{DynamicResource Brush.Background.App.Secondary}"
            Width="300" Height="400"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect RenderingBias="Quality" BlurRadius="10" Direction="315" ShadowDepth="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Добро пожаловать!" 
                           Foreground="{DynamicResource Brush.Foreground.Primary}" 
                           FontWeight="Bold" 
                           FontSize="20"
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,0"/>
                <Control Grid.Row="0" Template="{StaticResource PlaneTakeoffIcon}" Foreground="{DynamicResource Brush.Icon.PlaneTakeoffIcon}" Width="80"/>
            </StackPanel>

            <StackPanel Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="30">

                <TextBlock Text="Логин:" 
                           Style="{DynamicResource TextBlock.LoginView}"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource TextBox.Base}"
                         Margin="0,0,0,10"/>

                <TextBlock Text="Пароль:"
                           Style="{DynamicResource TextBlock.LoginView}"/>
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource TextBox.Base}"
                         Margin="0,0,0,20"/>

                <Button Content="Login" 
                        Command="{Binding LoginCommand}"
                        Style="{DynamicResource Button.App}"/>

                <TextBlock Text="{Binding ErrorMessage}" d:Text="Пример ошибки"
                           Foreground="{StaticResource Brush.Error}"
                           Margin="0,10,0,0"/>
                
                <TextBlock HorizontalAlignment="Center">
                    <Hyperlink NavigateUri="{Binding}" Foreground="{StaticResource Brush.Foreground.Hyperlink}">
                        <TextBlock Text="Востановление доступа" 
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

        </Grid>

    </Border>

</UserControl>