<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                               Кисти приложения                              ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Background.App.Header" Color="#191919"/>
    <SolidColorBrush x:Key="Brush.Background.App.Primary" Color="#191919"/>
    <SolidColorBrush x:Key="Brush.Background.App.Secondary" Color="#1F1F1F"/>

    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                 Кисти текста                                ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Foreground.Primary" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="Brush.Button.Foreground.Primary" Color="#F0F1F3"/>
    
    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                 Кисти Button                                ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Button.WindowMenagement.Background.MouseOver" Color="#292D36"/>
    <SolidColorBrush x:Key="Brush.Button.WindowMenagement.Background.Pressed" Color="#424242"/>
    <SolidColorBrush x:Key="Brush.Button.WindowMenagement.Background.Primary" Color="#002189"/>

    <SolidColorBrush x:Key="Brush.Button.Background.Primary" Color="#0F4C81"/>
    <SolidColorBrush x:Key="Brush.Button.Background.MouseOver" Color="#003366"/>
    <SolidColorBrush x:Key="Brush.Button.Background.Pressed" Color="#001D50"/>
    <SolidColorBrush x:Key="Brush.Button.Background.Enabled" Color="#5F5F5F"/>

    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                 Кисти TextBox                               ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.TextBox.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Brush.TextBox.Borderbrush" Color="White"/>
    <SolidColorBrush x:Key="Brush.TextBox.Borderbrush.Focused" Color="#3C3C3B"/>
    <SolidColorBrush x:Key="Brush.TextBox.Borderbrush.MouseOver" Color="#787877"/>

    <SolidColorBrush x:Key="Brush.Caret" Color="White"/>
    
    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                 Кисти Popup                                 ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Background.Popup" Color="#191919"/>
    <SolidColorBrush x:Key="Brush.BorderBrush.Popup" Color="#F1F1F1"/>


    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                Кисти границ                                 ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Border.Primary" Color="#505050"/>

    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                    Icons                                    ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Icon.Moon" Color="#ffce31"/>
    <SolidColorBrush x:Key="Brush.Icon.PlaneTakeoffIcon" Color="#0F4C81"/>

</ResourceDictionary>