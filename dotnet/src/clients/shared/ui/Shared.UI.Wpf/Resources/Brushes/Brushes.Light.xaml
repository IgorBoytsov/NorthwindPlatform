<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                               Кисти приложения                              ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Background.App.Header" Color="#002E5E"/>
    <SolidColorBrush x:Key="Brush.Background.App.Primary" Color="#E6E8EC"/>
    <SolidColorBrush x:Key="Brush.Background.App.Secondary" Color="#FFFFFF"/>

    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                 Кисти текста                                ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Foreground.Primary" Color="#000000"/>
    <SolidColorBrush x:Key="Brush.Button.Foreground.Primary" Color="#F0F1F3"/>

    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                 Кисти Button                                ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Button.WindowMenagement.Background.MouseOver" Color="#9BCEFF"/>
    <SolidColorBrush x:Key="Brush.Button.WindowMenagement.Background.Pressed" Color="#598CBD"/>
    <SolidColorBrush x:Key="Brush.Button.WindowMenagement.Background.Primary" Color="#0078D4"/>

    <SolidColorBrush x:Key="Brush.Button.Background.Primary" Color="#0076DC"/>
    <SolidColorBrush x:Key="Brush.Button.Background.MouseOver" Color="#003366"/>
    <SolidColorBrush x:Key="Brush.Button.Background.Pressed" Color="#001D50"/>
    <SolidColorBrush x:Key="Brush.Button.Background.Enabled" Color="#5F5F5F"/>

    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                 Кисти TextBox                               ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.TextBox.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Brush.TextBox.Borderbrush" Color="Black"/>
    <SolidColorBrush x:Key="Brush.TextBox.Borderbrush.Focused" Color="#3C3C3B"/>
    <SolidColorBrush x:Key="Brush.TextBox.Borderbrush.NouseOver" Color="#787877"/>

    <SolidColorBrush x:Key="Brush.Caret" Color="Black"/>

    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                 Кисти Popup                                 ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Background.Popup" Color="#598CFC"/>
    <SolidColorBrush x:Key="Brush.BorderBrush.Popup" Color="#191919"/>

    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                Кисти границ                                 ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Border.Primary" Color="#ACACAC"/>

    <!-- ╔═════════════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║                                    Icons                                    ║ -->
    <!-- ╚═════════════════════════════════════════════════════════════════════════════╝ -->

    <SolidColorBrush x:Key="Brush.Icon.Moon" Color="Black"/>
    <SolidColorBrush x:Key="Brush.Icon.PlaneTakeoffIcon" Color="#0F4C81"/>
    
</ResourceDictionary>